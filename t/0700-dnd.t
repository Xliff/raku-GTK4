my %xpm;

sub action-make-unique ($a) {
  return $a if $a.is-unique;

  return GDK_ACTION_COPY if $a +& GDK_ACTION_COPY;
  return GDK_ACTION_MOVE if $a +& GDK_ACTION_MOVE;
  return GDK_ACTION_LINK if $a +& GDK_ACTION_LINK;
  0;
}

my ($popped-up, $popup-window, $in-popup, $popdown-timer, $popup-timer, $grid);

sub popup-cb {
  unless $popped-up {
    unless $popup-window {
      ($popup-window, $grid) = (GTK::Window.new, GTK::Grid.new);
      for ^3 X ^3 -> ($i, $j) {
        my $button = GTK::Button.new-with-label("{ $i },{ $j }");
        $button.expand = True;
        $grid.attach($button, $i, $j);

        my $dest = GTK::DropTarget.new(G_TYPE_STRING, :copy, :move);
        $dest.Enter.tap( -> *@a {
          say "popup enter";
          unless $in-popup {
            $in-popup = True;
            if $popdown-timer {
              say "removed popdown";
              # cw: .cancel method on Int provided by GLibSource role in
              #     GLib::Timeout
              $popdown-timer.cancel( :clear );
            }
          }
        });

        sub onPopup {
          $popup-window.visible = False;
          $popped-up = False;
          0;
        }

        $dest.Leave.tap( -> *@a {
          say "popup leave";
          if $in-popup {
            $in-popup = False;
            unless $popdown-timer {
              say "added popdown";
              $popdown-timer = GLib::Timeout.add(500, -> *@a {
                onPopup();
              });
            }
          }
        });

        $dest.Drop.tap( -> *@a {
          onPopup();
          @a.tail.r = 1;
        });

        $button.add-controller($dest);
      }
      $popup-window.child = $grid;
    }
    $popup-window.visible = True;
    $popped-up = True;
  }
  $popup-timer = False;
}

sub MAIN {
  my $a = GTK::Application.new(
    title => 'org.genex.dnd.drop-target'
  );

  $a.Activate.tap( -> *@a {
    $a.window.child = ( my $grid = GTK::Grid.new );

    my %icons;
    %icons{ .key } = GDK::Pixbuf.new-from-xpm-data(.value) for %xpm.pairs;

    my $texture = GDK::Texture.new-for-pixbuf( %icons<drag-icon> );
    ( my $label = GTK::Label.new("Drop Here\n") ).expand = True;
    my $dest    = GDK::DropTarget.new(G_TYPE_STRING, :copy, :move);

    $dest.Drop.tap( -> *@a {
      my $v = GLib::Value.new( @a[1] );

      say "Received '{ $v.string }' in label";
      @a.r = 1;
    });
    $label.add-controller($dest);
    $grid.attach($label, 0, 0);

    ( my $pop-label = GTK::Label.new("Popup\n") ).expand = True;
    my $controller = GTK::Drop::Controller::Motion.new;
    $controller.Enter.tap( -> *@a {
      say "popsite enter";
      $popup-timer = GLib::Timeout.add(500, -> *@a {
        popup-cb();
      });
    });
    $controller.Leave.tap( -> *@a {
      say "popsite-leave\n";
      $popup-timer.cancel( :clear ) if $popup-timer;
    });
    $grid.attach($label, 1, 1);

    my $pixmap = GTK::Image.new-from-pixbuf( %icons<trashcan-closed> );
    $pixmap.expand = True;

    my $async  = GTK::Drop::Target::Async.new( :all );
    $async.Drag-Enter.tap( -> *@a {
      my $drop = GDK::Drop.new( @a[1] );
      $pixmap.set-from-pixbuf( %icons<trashcan-open> );
      say "trash enter: { $drop.get-formats.to-string }";
      @a.r = action-make-unique($drop.actions);
    });

    $async.Drag-Leave.tap( -> *@a {
      my $drop = GDK::Drop.new( @a[1] );
      $pixmap.set-from-pixbuf( %icons<trashcan-closed> );
      say "trash leave: { $drop.get-formats.to-string }";
      @a.r = action-make-unique($drop.actions);
    });

    $async.Drop.tap( -> *@a {
      my $drop = GDK::Drop.new( @a[1] );
      say "trash drop:{ $drop.get-formats.to-string }";
      $drop.finish( action-make-unique($drop.actions) );
      @a.r = 1;
    });

    $pixmap.add-controller($async);
    $grid.attach($pixmap, 1, 0);

    ( my $data-button = GTK::Label.new("Drag Here\n") ).expand = True;
    my $source  = GTK::DragSource.new;
    my $content = GDK::ContentProvider.new-typed("I'm data");
    $source.content = $content;
    $source.set-actions( :copy, :move );
    $data-button.add-controller($source);
    $source.set-icon($texture, 0, 0);
    $texture.unref;
    $grid.attach($data-button, 0, 1);

    $a.window.Destroy.tap( -> *@a { $a.quit });
    $a.window.present;
  });

  $a.run;
}


